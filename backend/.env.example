# ==============================================================================
# EDUMANAGE SAAS - PRODUCTION ENVIRONMENT ENVIRONMENT VARIABLES
# Copy this file to '.env' and populate your secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Configuration
# ------------------------------------------------------------------------------
# Generate a strong unique secret key for production:
# python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=django-insecure-school-saas-dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,xyz.com,.xyz.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. Domain & Tenant Configuration
# ------------------------------------------------------------------------------
# The base marketing domain under which all school subdomains are created:
MAIN_DOMAIN=xyz.com

# ------------------------------------------------------------------------------
# 3. Database Settings (SQLite / PostgreSQL Support)
# ------------------------------------------------------------------------------
# Default SQLite Database Engine configuration:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# To use PostgreSQL in production, uncomment and update these credentials:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=edumanage_prod_db
# DB_USER=db_admin_user
# DB_PASSWORD=your_secure_db_password_here
# DB_HOST=127.0.0.1
# DB_PORT=5432

# ------------------------------------------------------------------------------
# 4. SMTP Email Notification Server Configuration
# ------------------------------------------------------------------------------
# Configuration to dispatch password recovery links, fee alerts, and circulars:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_smtp_provider_credential_api_key_here
DEFAULT_FROM_EMAIL=EduManage SaaS Support <noreply@xyz.com>

# ------------------------------------------------------------------------------
# 5. Payments Gateways Configuration (Stripe / Razorpay)
# ------------------------------------------------------------------------------
# Setup payment keys to collect tenant subscription checkout fees:
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_keys_here
STRIPE_SECRET_KEY=sk_test_placeholder_keys_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_keys_here

RAZORPAY_KEY_ID=rzp_test_placeholder_key_id_here
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret_here

# ------------------------------------------------------------------------------
# 6. Twilio SMS Notification API Configuration
# ------------------------------------------------------------------------------
# Dispatches instant attendance alert messages or due fees warnings to parents:
TWILIO_ACCOUNT_SID=AC_twilio_account_sid_placeholder_here
TWILIO_AUTH_TOKEN=twilio_auth_token_placeholder_here
TWILIO_PHONE_NUMBER=+1234567890
